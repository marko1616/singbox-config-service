{
  "public_base_url": "<HTTPS_PUBLIC_BASE_URL_WITH_OPTIONAL_PATH_PREFIX>",
  "devices": [
    {
      "id": "phone",
      "api_key": "<REPLACE_WITH_RANDOM_KEY_AT_LEAST_32_CHARACTERS>",
      "services": [
        "normal",
        "sg-business",
        "resolver",
        "bypass"
      ],
      "mode": "global",
      "ingress": "mixed"
    }
  ],
  "shared": {
    "subscriptions": [
      {
        "name": "primary",
        "url": "<HTTPS_SUBSCRIPTION_URL>",
        "user_agent": "",
        "fetch_method": "curl",
        "update_policy": "poll"
      }
    ],
    "top_k": 3,
    "refresh_seconds": 300,
    "probe_timeout_seconds": 10,
    "probe_workers": 4,
    "max_candidates": 1000,
    "hk_pattern": "(?i)(香港|Hong.?Kong|\\bHK\\b|🇭🇰)",
    "sg_pattern": "(?i)(新加坡|Singapore|\\bSG\\b|🇸🇬)",
    "manual_nodes": [],
    "own_hy2": null,
    "probe_interval_seconds": 900,
    "rename_rules": []
  },
  "services": {
    "normal": {
      "type": "proxy"
    },
    "sg-business": {
      "type": "singapore",
      "rules": {
        "ip_cidr": [],
        "domain": [],
        "domain_suffix": [],
        "domain_regex": []
      }
    },
    "resolver": {
      "type": "dns",
      "hosts": {}
    },
    "bypass": {
      "type": "direct",
      "rules": {
        "ip_cidr": [],
        "domain": [],
        "domain_suffix": [],
        "domain_regex": []
      }
    },
    "overlay": {
      "type": "wireguard"
    }
  }
}
