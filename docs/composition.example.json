{
  "public_base_url": "<HTTPS_PUBLIC_BASE_URL_WITH_OPTIONAL_PATH_PREFIX>",
  "devices": [
    {
      "id": "phone",
      "api_key": "<PHONE_RANDOM_KEY_AT_LEAST_32_CHARACTERS>",
      "services": [
        "normal",
        "sg-business",
        "resolver",
        "bypass"
      ],
      "mode": "blacklist",
      "ingress": "both"
    },
    {
      "id": "laptop",
      "api_key": "<LAPTOP_RANDOM_KEY_AT_LEAST_32_CHARACTERS>",
      "services": [
        "normal",
        "resolver"
      ],
      "mode": "global",
      "ingress": "mixed"
    },
    {
      "id": "dns-client",
      "api_key": "<DNS_RANDOM_KEY_AT_LEAST_32_CHARACTERS>",
      "services": [
        "resolver"
      ],
      "mode": "global",
      "ingress": "mixed"
    }
  ],
  "shared": {
    "subscriptions": [
      {
        "name": "tag",
        "url": "<TAG_HTTPS_SUBSCRIPTION_URL>",
        "user_agent": "curl/8.10.1",
        "fetch_method": "curl",
        "rename_rules": [
          {
            "pattern": "^(?:[🇦-🇿]{2}\\s*)?(.+?)[-\\s]?(家宽|住宅|游戏|蜂窝5G|星链|实验节点)?(?:\\s+\\d+)?[丨|].*$",
            "replacement": "$1-$2-$index",
            "capture_defaults": {
              "2": "普通"
            }
          }
        ],
        "update_policy": "startup"
      },
      {
        "name": "other",
        "url": "<OTHER_HTTPS_SUBSCRIPTION_URL>",
        "user_agent": "",
        "fetch_method": "curl",
        "rename_rules": [
          {
            "pattern": "^(?:[🇦-🇿]{2}\\s*)?(?=[A-Za-z]+\\s*(香港|新加坡|日本|台湾|美国|英国|韩国))([A-Za-z]+).*",
            "replacement": "$1-$2-$index"
          }
        ],
        "update_policy": "poll",
        "interval_seconds": 300
      }
    ],
    "top_k": 3,
    "refresh_seconds": 300,
    "probe_timeout_seconds": 10,
    "probe_workers": 4,
    "max_candidates": 1000,
    "hk_pattern": "(?i)(香港|Hong.?Kong|\\bHK\\b|🇭🇰)",
    "sg_pattern": "(?i)(新加坡|Singapore|\\bSG\\b|🇸🇬)",
    "manual_nodes": [],
    "own_hy2": null,
    "probe_interval_seconds": 900,
    "rename_rules": []
  },
  "services": {
    "normal": {
      "type": "proxy"
    },
    "sg-business": {
      "type": "singapore",
      "rules": {
        "ip_cidr": [],
        "domain": [],
        "domain_suffix": [
          "sg-business.example.invalid"
        ],
        "domain_regex": []
      }
    },
    "resolver": {
      "type": "dns",
      "hosts": {
        "internal.example.invalid": [
          "192.0.2.10"
        ]
      }
    },
    "bypass": {
      "type": "direct",
      "rules": {
        "ip_cidr": [],
        "domain": [],
        "domain_suffix": [],
        "domain_regex": []
      }
    },
    "overlay": {
      "type": "wireguard"
    }
  }
}
